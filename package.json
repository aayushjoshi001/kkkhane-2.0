{
  "name": "kkkhane",
  "description": "Multi-tenant hotel and restaurant management SaaS for Nepal — POS, QR ordering, kitchen display, room bookings, folio billing and finance.",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=20.9.0"
  },
  "scripts": {
    "dev": "next dev --turbo",
    "build": "next build",
    "start": "next start",
    "typecheck": "tsc --noEmit",
    "lint": "eslint",
    "lint:fix": "eslint --fix",
    "test": "playwright test --project=chromium",
    "test:headed": "playwright test --project=chromium --headed",
    "test:ci": "playwright test --project=chromium --reporter=github,html",
    "test:report": "playwright show-report",
    "db:reset": "supabase db reset",
    "db:diff": "supabase db diff -f",
    "db:push": "supabase db push",
    "gen:tenant-tables": "node scripts/gen-tenant-tables.mjs",
    "gen:logo-raster": "node scripts/generate-logo-raster.mjs"
  },
  "dependencies": {
    "@marsidev/react-turnstile": "^1.5.3",
