    "@supabase/supabase-js": "^2.99.1",
    "@tanstack/react-virtual": "^3.14.5",
    "@upstash/qstash": "^2.11.1",
    "@upstash/ratelimit": "^2.0.8",
    "@upstash/redis": "^1.36.4",
    "bcryptjs": "^3.0.3",
    "clsx": "^2.1.1",
    "cmdk": "^1.1.1",
    "esbuild": "^0.28.1",
    "framer-motion": "^12.42.2",
    "jspdf": "^4.2.1",
    "jszip": "^3.10.1",
    "leaflet": "^1.9.4",
    "lucide-react": "^0.577.0",
    "nepali-date-converter": "^3.4.0",
    "nepalify": "^0.5.0",
    "next": "^16.2.9",
    "qrcode": "^1.5.4",
    "qrcode.react": "^4.2.0",
    "qz-tray": "^2.2.6",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-hot-toast": "^2.6.0",
    "react-leaflet": "^5.0.0",
    "resend": "^6.9.3",
    "serwist": "^9.5.11",
    "swr": "^2.4.1",
    "tailwind-merge": "^3.5.0",
