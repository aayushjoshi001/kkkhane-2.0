    "@types/leaflet": "^1.9.21",
    "@types/next-pwa": "^5.6.9",
    "@types/node": "^20",
    "@types/pg": "^8.20.0",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.1.6",
    "pg": "^8.22.0",
    "tailwindcss": "^4",
    "typescript": "^5.9.3"
  }
