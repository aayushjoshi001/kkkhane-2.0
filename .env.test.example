# E2E test credentials — copy to .env.test and fill in values
# These point at a dedicated test restaurant in your Supabase instance.
# Never use production credentials here.

BASE_URL=http://localhost:3000

# Manager account for the test restaurant
E2E_MANAGER_EMAIL=test-manager@example.com
E2E_MANAGER_PASSWORD=YourTestPassword123!

# Table slug for the test restaurant (used in /t/{slug})
E2E_TABLE_SLUG=test-restaurant

# A valid open session token for the test table
# Generate by opening a table session in the waiter interface
E2E_SESSION_TOKEN=xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx

# Takeout slug (defaults to E2E_TABLE_SLUG if not set)
E2E_TAKEOUT_SLUG=test-restaurant
