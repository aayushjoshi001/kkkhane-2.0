# ============================================================================
# KKKhane — environment template
# ============================================================================
# Copy to `.env.local` and fill in. Every variable below is one the code
# actually reads; if you add a new `process.env.X`, add it here in the same
# commit. Anything optional is safe to leave unset — the feature that uses it
# degrades or no-ops rather than crashing.
#
# Production values live in Vercel (Project → Settings → Environment Variables)
# and are marked Sensitive, so they cannot be read back out. Treat Vercel as the
# source of truth and keep a local copy of anything you generate.
# ============================================================================

# --- Supabase (REQUIRED) --------------------------------------------------
# Project URL and keys: https://app.supabase.com → Project Settings → API
# SUPABASE_SERVICE_ROLE_KEY bypasses RLS. Server-side only, never expose it.
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_key
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key

# --- App (REQUIRED) -------------------------------------------------------
# Absolute origin, no trailing slash. Used to build QR links, e-mail links and
# OAuth redirects, so it must match the domain users actually land on.
NEXT_PUBLIC_APP_URL=https://your-production-domain.com

# --- Endpoint secrets (REQUIRED in production) ----------------------------
# Each gates a privileged endpoint and must be a long random string
# (`openssl rand -hex 32`). All three fail CLOSED when unset: the endpoint
# rejects every request rather than running unauthenticated.
#   CRON_SECRET       Bearer token Vercel Cron presents to /api/cron/*
#   REVALIDATE_SECRET on-demand ISR revalidation, /api/revalidate
#   SRMS_API_KEY      Bearer token for the external orders API, /api/orders
CRON_SECRET=
REVALIDATE_SECRET=
SRMS_API_KEY=

# --- Rate limiting / cache (OPTIONAL) -------------------------------------
# Upstash Redis: https://console.upstash.com
# Unset, or unreachable, the limiter fails OPEN — requests are allowed through
# rather than blocked. Set it before taking real traffic.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# --- Background jobs (OPTIONAL) -------------------------------------------
# Upstash QStash. Signing keys verify inbound job callbacks; without them the
# webhook rejects everything, so set all four together or none.
QSTASH_URL=
QSTASH_TOKEN=
QSTASH_CURRENT_SIGNING_KEY=
QSTASH_NEXT_SIGNING_KEY=

# --- E-mail (REQUIRED for invites, receipts and password resets) ----------
# Brevo is preferred. Verify the sender/domain, then create an API key under
# SMTP & API → API Keys. The Resend variables remain as a migration fallback.
BREVO_API_KEY=
BREVO_FROM_EMAIL=noreply@your-domain.com
BREVO_FROM_NAME=KKKhane
# Resend fallback: https://resend.com/api-keys
RESEND_API_KEY=
RESEND_FROM_EMAIL=noreply@your-domain.com

# --- SMS (OPTIONAL — order and loyalty notices no-op silently if unset) ---
# Sparrow SMS is preferred when set: better delivery and lower cost to Nepal
# (+977) numbers. Token from https://ent.sparrowsms.com (Token Management).
SPARROW_SMS_TOKEN=
SPARROW_SMS_FROM=YourApprovedSenderId
# Fallback, used only when the Sparrow pair is unset. https://bird.com
MESSAGEBIRD_API_KEY=
MESSAGEBIRD_ORIGINATOR=YourBrand

# --- Bot protection (OPTIONAL) --------------------------------------------
# Cloudflare Turnstile on signup and login. Both halves or neither.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# --- Error tracking (OPTIONAL) --------------------------------------------
# Sentry. The two DSNs are the same value; the NEXT_PUBLIC_ one reaches the
# browser bundle. ORG/PROJECT/AUTH_TOKEN are build-time only — they upload
# source maps, and their absence just means unminified stack traces.
SENTRY_DSN=
NEXT_PUBLIC_SENTRY_DSN=
SENTRY_ORG=
SENTRY_PROJECT=
SENTRY_AUTH_TOKEN=
# Verbose Sentry logging. Leave unset outside debugging.
SENTRY_DEBUG=

# --- Thermal printing (OPTIONAL) ------------------------------------------
# QZ Tray silent-print certificate, base64-encoded. Without these QZ prompts
# the cashier to approve every single print job.
#   base64 -w0 digital-certificate.txt
#   base64 -w0 private-key.pem
QZ_CERTIFICATE=
QZ_PRIVATE_KEY=

# --- Nepal payment gateways (OPTIONAL — required for instant QR activation) -
# eSewa: PRODUCT_CODE is your merchant code (EPAYTEST in sandbox). SECRET_KEY is
# the HMAC key from your eSewa Merchant dashboard. Without these, eSewa and Khalti
# buttons are hidden and customers use the manual bank-transfer flow.
#   Sandbox dashboard: https://merchant.esewa.com.np (test mode)
#   Production:        https://merchant.esewa.com.np
ESEWA_PRODUCT_CODE=EPAYTEST
ESEWA_SECRET_KEY=8gBm/:&EnhH.1/q

# Khalti: SECRET_KEY from https://admin.khalti.com → API Keys.
# Test key always starts with "test_secret_key_"; live key starts with "live_secret_key_".
KHALTI_SECRET_KEY=test_secret_key_dc74e0fd5737c8143c4a0932f76d8445

# FonePay: MERCHANT_CODE (PID) and SECRET_KEY from https://business.fonepay.com → Integration.
# Sandbox:    MERCHANT_CODE=TEST_MERCHANT  (any key works; verification is skipped in sandbox)
# Production: use the credentials FonePay issues after merchant activation.
FONEPAY_MERCHANT_CODE=TEST_MERCHANT
FONEPAY_SECRET_KEY=test_fonepay_secret

# --- Local development only -----------------------------------------------
# Shows the one-click demo-account chips on the login screen. Never set in
# production: it is the switch that keeps demo logins off the live site.
SHOW_DEMO_ACCOUNTS=
